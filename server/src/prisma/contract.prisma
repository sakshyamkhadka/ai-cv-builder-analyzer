model User {
  id                          Int                        @id @default(autoincrement())
  name                        String
  email                       String                     @unique
  password                    String
 emailVerified               Boolean              @default(false)
 emailVerificationTokenHash  String?              @unique
 emailVerificationExpiresAt  TimestamptzString?
 passwordResetTokenHash      String?              @unique
 passwordResetExpiresAt      TimestamptzString?
  phone                       String?
  role                        String                     @default("USER")
  createdAt                   TimestamptzString          @default(now())
  updatedAt                   temporal.updatedAtString()

  cvs             CV[]
  jobDescriptions JobDescription[]
  analyses        CVAnalysis[]
  jobMatches      JobMatch[]
}
model CV {
  id             Int                        @id @default(autoincrement())
  user           User                       @relation(fields:[userId], references:[id])
  userId         Int
  title          String
  template       Template                   @relation(fields:[templateId], references:[id])
  templateId     Int
  summary        String?
  createdAt      TimestamptzString          @default(now())
  updatedAt      temporal.updatedAtString()

  educations     Education[]
  skills         Skill[]
  experiences    Experience[]
  projects       Project[]
  certifications Certification[]
  languages      Language[]
  analyses       CVAnalysis[]
  jobMatches     JobMatch[]
}

model Education {
  id          Int     @id @default(autoincrement())
  cv          CV      @relation(fields:[cvId], references:[id])
  cvId        Int
  institution String
  degree      String
  field       String?
  startDate   String?
  endDate     String?
  description String?
}

model Skill {
  id    Int     @id @default(autoincrement())
  cv    CV      @relation(fields:[cvId], references:[id])
  cvId  Int
  name  String
  level String?
}

model Experience {
  id          Int     @id @default(autoincrement())
  cv          CV      @relation(fields:[cvId], references:[id])
  cvId        Int
  company     String
  position    String
  startDate   String?
  endDate     String?
  description String?
}

model Project {
  id           Int     @id @default(autoincrement())
  cv           CV      @relation(fields:[cvId], references:[id])
  cvId         Int
  name         String
  description  String?
  technologies String?
  projectUrl   String?
}

model Certification {
  id            Int     @id @default(autoincrement())
  cv            CV      @relation(fields:[cvId], references:[id])
  cvId          Int
  name          String
  organization  String?
  issueDate     String?
  credentialUrl String?
}

model Language {
  id          Int     @id @default(autoincrement())
  cv          CV      @relation(fields:[cvId], references:[id])
  cvId        Int
  name        String
  proficiency String?
}

model Template {
  id           Int                        @id @default(autoincrement())
  name         String
  slug         String                     @unique
  description  String?
  previewImage String?
  isActive     Boolean                    @default(true)
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()

  cvs          CV[]
}

model CVAnalysis {
  id           Int               @id @default(autoincrement())
  user         User              @relation(fields:[userId], references:[id])
  userId       Int
  cv           CV                @relation(fields:[cvId], references:[id])
  cvId         Int
  overallScore Int?
  summary      String?
  strengths    String?
  weaknesses   String?
  suggestions  String?
  createdAt    TimestamptzString @default(now())
}

model JobDescription {
  id          Int               @id @default(autoincrement())
  user        User              @relation(fields:[userId], references:[id])
  userId      Int
  title       String
  company     String?
  description String
  createdAt   TimestamptzString @default(now())

  matches     JobMatch[]
}

model JobMatch {
  id               Int               @id @default(autoincrement())
  user             User              @relation(fields:[userId], references:[id])
  userId           Int
  cv               CV                @relation(fields:[cvId], references:[id])
  cvId             Int
  jobDescription   JobDescription    @relation(fields:[jobDescriptionId], references:[id])
  jobDescriptionId Int
  matchScore       Int?
  matchingSkills   String?
  missingSkills    String?
  suggestions      String?
  createdAt        TimestamptzString @default(now())
}
